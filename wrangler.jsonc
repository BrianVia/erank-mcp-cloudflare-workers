{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "erank-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-12",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ERANK_SESSION", "class_name": "ErankSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ErankSession"] }],
  "routes": [{ "pattern": "erank.example.com", "custom_domain": true }]
}
